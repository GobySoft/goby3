# Generated by 'goby interface systemd' from systemd_fleet.yml: edit that file rather than this one.
[Unit]
Description=nav_driver (bot1 of systemd_fleet)
PartOf=systemd_fleet-bot1.target
After=gobyd.service
BindsTo=gobyd.service
ConditionPathExists=/dev/ttyUSB0

[Service]
User=fleet
Group=fleet
ExecStart=nav_driver /etc/fleet/bot1.pb.cfg
ExecStop=goby_terminate --target_pid $MAINPID
Restart=on-failure
LimitCORE=infinity

[Install]
WantedBy=systemd_fleet-bot1.target
