vars: { d2-config: { layout-engine: elk } }
direction: right
classes: {
  platform: { style.stroke: "#006400"; style.font-color: "#006400"; style.stroke-width: 2; style.fill: transparent }
  module: { style.stroke: "#cd8500"; style.font-color: "#cd8500"; style.stroke-width: 2; style.fill: transparent }
  application: { style.stroke: "#104e8b"; style.font-color: "#104e8b"; style.stroke-width: 2; style.fill: transparent }
  thread: { style.stroke: "#551a8b"; style.font-color: "#551a8b" }
  placeholder: { shape: text; style.font-color: "#888888" }
  interthread: { style.stroke: "#551a8b"; style.font-size: 10 }
  interprocess: { style.stroke: "#104e8b"; style.font-size: 10 }
  intermodule: { style.stroke: "#cd8500"; style.font-size: 10 }
  intervehicle: { style.stroke: "#006400"; style.font-size: 10 }
  required: { style.stroke-width: 3 }
  recommended: { style.stroke-dash: 6 }
  regex: { style.stroke-dash: 2 }
  dynamic: { style.stroke-dash: 4 }
  unmet: { style.stroke: red; style.stroke-width: 3 }
}
goby_platform: {
  class: platform
  goby_gps: {
    class: application
    GPSDClient: { class: thread; label: "goby::apps::zeromq::GPSDClient"; tooltip: "T0: tcp_out | CXX_OBJECT | goby::middleware::protobuf::IOData\nP0: goby::middleware::groups::gpsd::att | PROTOBUF | goby::middleware::protobuf::gpsd::Attitude\nP1: goby::middleware::groups::gpsd::sky | PROTOBUF | goby::middleware::protobuf::gpsd::SkyView\nP2: goby::middleware::groups::gpsd::tpv | PROTOBUF | goby::middleware::protobuf::gpsd::TimePositionVelocity" }
    HealthMonitorThread: { class: thread; label: "goby::middleware::HealthMonitorThread<...>"; tooltip: "goby::middleware::HealthMonitorThread&lt;struct goby::zeromq::detail::InterProcessTag&gt;" }
    TCPClientThread: { class: thread; label: "goby::middleware::io::detail::TCPClientThread<...>"; tooltip: "goby::middleware::io::detail::TCPClientThread&lt;tcp_in, tcp_out, goby::middleware::io::PubSubLayer::INTERTHREAD, goby::middleware::io::PubSubLayer::INTERTHREAD, class goby::middleware::protobuf::TCPClientConfig, goby::zeromq::SimpleThread&gt;\nT11: tcp_in | CXX_OBJECT | goby::middleware::protobuf::IOData\nT12: tcp_in | CXX_OBJECT | goby::middleware::protobuf::IOStatus\nT13: tcp_in | CXX_OBJECT | goby::middleware::protobuf::TCPClientEvent\nT14: tcp_in | CXX_OBJECT | enum goby::middleware::io::ThreadState" }
    no_subscriber: { class: placeholder; label: "no subscriber" }
  }
}
goby_platform.goby_gps.GPSDClient -> goby_platform.goby_gps.TCPClientThread: "T0 [tcp_out]" { class: interthread; tooltip: "T0: tcp_out | CXX_OBJECT | goby::middleware::protobuf::IOData" }
