vars: { d2-config: { layout-engine: elk } }
direction: right
classes: {
  platform: { style.stroke: "#006400"; style.font-color: "#006400"; style.stroke-width: 2; style.fill: transparent }
  module: { style.stroke: "#cd8500"; style.font-color: "#cd8500"; style.stroke-width: 2; style.fill: transparent }
  application: { style.stroke: "#104e8b"; style.font-color: "#104e8b"; style.stroke-width: 2; style.fill: transparent }
  thread: { style.stroke: "#551a8b"; style.font-color: "#551a8b" }
  placeholder: { shape: text; style.font-color: "#888888" }
  interthread: { style.stroke: "#551a8b"; style.font-size: 10 }
  interprocess: { style.stroke: "#104e8b"; style.font-size: 10 }
  intermodule: { style.stroke: "#cd8500"; style.font-size: 10 }
  intervehicle: { style.stroke: "#006400"; style.font-size: 10 }
  required: { style.stroke-width: 3 }
  recommended: { style.stroke-dash: 6 }
  regex: { style.stroke-dash: 2 }
  dynamic: { style.stroke-dash: 4 }
  unmet: { style.stroke: red; style.stroke-width: 3 }
}
auv: {
  class: platform
  label: "auv (gobyd)"
  controller: {
    class: application
    Controller: { class: thread; tooltip: "P5: nav::command | PROTOBUF | nav::protobuf::Command" }
    no_publisher: { class: placeholder; label: "no publisher" }
  }
  goby_coroner: {
    class: application
  }
  nav_driver: {
    class: application
    Driver: { class: thread; label: "nav::Driver"; tooltip: "T4: nav::raw_out | CXX_OBJECT | std::string\nP2: nav::fix | PROTOBUF | nav::protobuf::Fix\nV0: nav::status;1 | DCCL | nav::protobuf::Status" }
    SerialThread: { class: thread; label: "nav::SerialThread"; tooltip: "T5: nav::raw_in | CXX_OBJECT | std::string" }
    no_subscriber: { class: placeholder; label: "no subscriber" }
  }
}
auv.controller.Controller -> auv.nav_driver.Driver: "P5 [command]" { class: [interprocess; recommended]; tooltip: "P5: nav::command | PROTOBUF | nav::protobuf::Command" }
auv.nav_driver.Driver -> auv.nav_driver.SerialThread: "T4 [raw_out]" { class: interthread; tooltip: "T4: nav::raw_out | CXX_OBJECT | std::string" }
auv.nav_driver.SerialThread -> auv.nav_driver.Driver: "T5 [raw_in]" { class: interthread; tooltip: "T5: nav::raw_in | CXX_OBJECT | std::string" }
auv.nav_driver.Driver -> auv.controller.Controller: "P2 [fix]" { class: [interprocess; required]; tooltip: "P2: nav::fix | PROTOBUF | nav::protobuf::Fix" }
auv.nav_driver.Driver -> auv.nav_driver.no_subscriber: "V0 [status;1]" { class: intervehicle; tooltip: "V0: nav::status;1 | DCCL | nav::protobuf::Status" }
auv.controller.no_publisher -> auv.controller.Controller: "P11 [depth]" { class: [interprocess; required; unmet]; tooltip: "P11: nav::depth | PROTOBUF | nav::protobuf::Depth" }
auv.controller.no_publisher -> auv.controller.Controller: "M0 [science]" { class: intermodule; tooltip: "M0: payload::science | PROTOBUF | payload::protobuf::Science" }
