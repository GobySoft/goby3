#!/usr/bin/env -S goby_launch -P -d 100 -p hub
# Generated by 'goby interface launch' from launch_fleet.yml for hub: edit that file rather than this one.
[kill=SIGTERM] gpsd -N /dev/ttyUSB0
gobyd <(./gen.sh gobyd)
[env=HUB_PLUGINS=libfleet_hub.so.1:libfleet_extra.so.1] hub_manager <(./gen.sh hub_manager)
engineering_display <(./gen.sh engineering_display)
goby_coroner <(./gen.sh goby_coroner) --expected_name gobyd --expected_name hub_manager --expected_name engineering_display
