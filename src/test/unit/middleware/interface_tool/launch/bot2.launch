#!/usr/bin/env -S goby_launch -L -P -p bot2
# Generated by 'goby interface launch' from launch_fleet.yml for bot2: edit that file rather than this one.
gobyd bot2.pb.cfg -v --hold 'required_client: "mission_manager"'
mission_manager bot2.pb.cfg -v
# (enabled: false) [name=mission_backup] mission_manager bot2.pb.cfg -v
[kill=SIGTERM] MOOSDB /tmp/bot2.moos
[kill=SIGTERM, name=engineering_display] /bin/bash -c "if echo \"${fleet_bot_type}\" | grep -qE \"STORM\"; then exec engineering_display bot2.pb.cfg -v; else exec sleep infinity; fi"
goby_coroner bot2.pb.cfg -v --expected_name gobyd --expected_name mission_manager
