<server>
    <application-settings location="*">
        <log-config>* -debug</log-config>
        <!-- kB: room for an ENC upload, which can hold many cells -->
        <max-request-size>131072</max-request-size>
        <properties>
            <property name="leafletJSURL">leaflet/1.9.4/leaflet.js</property>
            <property name="leafletCSSURL">leaflet/1.9.4/leaflet.css</property>
        </properties>
    </application-settings>
</server>
